rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tabela de usuários do Salesforce (perfis, doc = UID do Authentication,
    // sem senha): o próprio usuário lê o próprio perfil no login; a escrita
    // é exclusiva do UID administrador da plataforma (área /admin).
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == 'YmX7asMWDEcCPkQMtHrgaz1wVOV2');
      allow write: if request.auth != null
        && request.auth.uid == 'YmX7asMWDEcCPkQMtHrgaz1wVOV2';
    }

    // Regras de DESENVOLVIMENTO para as demais coleções: liberam
    // leitura/escrita sem Firebase Auth. Para produção, exija
    // request.auth != null e restrinja por empresa/usuário.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
