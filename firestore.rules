rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de DESENVOLVIMENTO: liberam leitura/escrita sem Firebase Auth.
    // Uso: `firebase deploy --only firestore:rules` com o projeto de
    // desenvolvimento. Para produção, exija request.auth != null e restrinja
    // por empresa/usuário em vez de allow read, write: if true.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
